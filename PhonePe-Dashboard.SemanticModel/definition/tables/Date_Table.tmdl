		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: 34cd4dac-0f43-4de8-af94-7b331c3cd813
			defaultHierarchy: LocalDateTable_2e42ea53-f37d-409e-9222-bcdae5622b5c.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 87f3afd7-5c55-467a-a758-44e8f870053f
		summarizeBy: sum

	column Quarter
		lineageTag: e2e08fc4-46ac-426f-bb38-47084ae80ed1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	partition Date_Table = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(All_Transactions[Date]),
				        MAX(All_Transactions[Date])
				    ),
				    "Year", YEAR([Date]),
				    "Month No.", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day No.", WEEKDAY([Date], 2),
				    "Weekday", FORMAT([Date], "ddd"),
				    "Weekend",
				        IF(
				            WEEKDAY([Date], 2) >= 6,
				            "Weekend",
				            "Weekday"
				        )
				)

	annotation PBI_Id = 2d07d3f7cbad4df89a1586c1f169b53d

